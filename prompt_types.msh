enum Base16Color =
      baseBlack
    | baseRed
    | baseGreen
    | baseYellow
    | baseBlue
    | baseMagenta
    | baseCyan
    | baseWhite
end

enum TextAttribute =
      attrReset
    | attrBold
    | attrFaint
    | attrItalic
    | attrUnderline
    | attrBlinking
    | attrHighlighted
    | attrHidden
    | attrStrikethrough
end

enum BaseBrightness = baseNormal | baseBright end

enum CursorShape =
      blinkingBlock
    | steadyBlock
    | blinkingUnderline
    | steadyUnderline
    | blinkingBar
    | steadyBar
end

enum PromptItem = propmtText str
            | setFgColorRgb int int int
            | setBgColorRgb int int int
            | setFgColorBase16 Base16Color BaseBrightness
            | setBgColorBase16 Base16Color BaseBrightness
            | setTextAttr TextAttribute
            | setCursorShape CursorShape
        end

# def setPrompt (( -- [PromptItem])) takes a quote that produces the list of PromptItems
