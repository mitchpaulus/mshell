'5 5 Sep' toDt match just d: $"5 5 Sep -> {@d isoDateFmt}", none: "5 5 Sep -> none", end wl
'5 5 2025' toDt match just d: $"5 5 2025 -> {@d isoDateFmt}", none: "5 5 2025 -> none", end wl
