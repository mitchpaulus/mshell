def returnTest (str -- str)
    a!
    @a "a" = if "Found a" return end
    @a "b" = if "Found b" return end
    "Found c"
end

def skipAfterReturn (-- str)
    "Early return"
    return
    "Should not see"
end

def stopBeforeError (-- str)
    "Safe before error"
    return
    1 0 /
end

"a" returnTest wl
"b" returnTest wl
"c" returnTest wl

skipAfterReturn wl
stopBeforeError wl
