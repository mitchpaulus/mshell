# The abbreviation builtins in a script: adding, replacing, renaming,
# erasing and listing. A script never expands them.
def upDirs (AbbrInfo -- Maybe[str])
    :word? len 1 - n!
    '..' @n repeat '/' join up!
    $"'{@up}' cd" just
end

's' 'git status -u' abbr
{abbr: 'co' abbrWord, expansion: 'checkout' abbrText, position: ['git' 'hg'] abbrArgOf, description: 'git checkout'} abbrAdd
{abbr: 'gcm' abbrWord, expansion: "git commit -m '%'" abbrText, cursorMarker: '%'} abbrAdd
{abbr: '\.\.+' abbrRegex, expansion: (upDirs) abbrFunc} abbrAdd
{abbr: 'l' abbrWord, expansion: 'ls -alh' abbrText} abbrAdd
{abbr: 'l' abbrWord, expansion: 'log' abbrText, position: ['jj'] abbrArgOf} abbrAdd
abbrShow

"--- Same abbr and position: replaced, and now the newest." wl
's' 'git status' abbr
abbrShow

"--- Rename and erase." wl
'co' abbrWord 'ck' abbrWord abbrRename
'l' abbrWord abbrErase
'missing' abbrWord abbrErase
'missing' abbrWord 'other' abbrWord abbrRename
abbrShow

"--- Values that can never expand are added, not errors." wl
{abbr: 'two words' abbrWord, expansion: 'x' abbrText} abbrAdd
{abbr: '(' abbrRegex, expansion: 'x' abbrText} abbrAdd
{abbr: 'm' abbrWord, expansion: 'x' abbrText, position: [] abbrArgOf} abbrAdd
abbrList len wl
abbrList (:abbr? 'gcm' abbrWord =) any str wl
abbrList (:abbr? 'gcm' abbrRegex =) any str wl

"--- A function, called by hand." wl
{word: '...', command: none, line: '...'} upDirs ? wl

"--- A list of different literals." wl
[
    {abbr: 'a' abbrWord, expansion: 'git add' abbrText}
    {abbr: 'b' abbrWord, expansion: 'git branch' abbrText, position: abbrAnywhere}
] as [Abbr] (abbrAdd) each
abbrList len wl
