"hello world" urlEncode wl
"a&b=c?d e" urlEncode wl
"100% off" urlEncode wl
"slash/and+plus" urlEncode wl
"unicode: café" urlEncode wl
{"q": "go lang", "n": 2} urlEncode wl
{"tag": ["a" "b" "c"]} urlEncode wl
{"n": [1 2 3]} urlEncode wl
{"q": "a&b=c"} urlEncode wl
# Lists of different element types in one dict literal, and a stored list
# given its wide type where it is made.
{"data": ["a" "b"], "report_type": [3 4]} urlEncode wl
["x" "y"] as [str | path | int] cols!
{"data": @cols, "year": 2026, "report_type": [3 4]} as {UrlEncodable} params!
@params urlEncode wl
