# zipPack custom entry coverage.
tempFile pack-zip!

[
    {
        path: `zip/base/alpha.txt`,
        archivePath: "packed/alpha.txt",
        mode: 420 # '0b110100100'
    }
    {
        path: `zip/extra/extra.txt`,
        archivePath: "extras/extra.txt",
        mode: 493
    }
    `zip/base/repeat.txt`
    "zip/base/nested"
# The stored list is given the entry type where it is made: lists are
# invariant. The core checker's built-in name for it is PackEntry
# (`] as [PackEntry] pack-items!`); the old checker does not know it.
] as [str | path | {path: str | path, archivePath?: str | path, mode?: int}] pack-items!

@pack-items @pack-zip zipPack

"zipPack entries" wl
@pack-zip zipList (i! [@i "name" get? @i "perm" get? str @i "executable" get? str] tjoin) map sortV uw
'' wl

"zipPack alpha" wl
@pack-zip "packed/alpha.txt" zipRead ? utf8Str wl

"zipPack extra" wl
@pack-zip "extras/extra.txt" zipRead ? utf8Str wl
