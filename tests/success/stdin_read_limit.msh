# MSH_READ_LIMIT caps how much the stdin builtin will read. It is read at call time.
"MSH_READ_LIMIT" "5" setenv

# Empty input
(stdin len wl) "" < x

# One below, exact
(stdin len wl) "hell" < x
(stdin len wl) "hello" < x

# K suffix: one below and exact 1024
"MSH_READ_LIMIT" "1k" setenv
(stdin len wl) "x" 1023 repeat "" join < x
(stdin len wl) "x" 1024 repeat "" join < x
"MSH_READ_LIMIT" "1KB" setenv
(stdin len wl) "x" 1024 repeat "" join < x
"MSH_READ_LIMIT" "1KiB" setenv
(stdin len wl) "x" 1024 repeat "" join < x

# M suffix: one below and exact 1048576
"MSH_READ_LIMIT" "1M" setenv
(stdin len wl) "x" 1048575 repeat "" join < x
(stdin len wl) "x" 1048576 repeat "" join < x
"MSH_READ_LIMIT" "1MB" setenv
(stdin len wl) "x" 1048576 repeat "" join < x

# G suffix: 1M input is well under 1 GiB
"MSH_READ_LIMIT" "1G" setenv
(stdin len wl) "x" 1048576 repeat "" join < x

# 0 removes the limit
"MSH_READ_LIMIT" "0" setenv
(stdin len wl) "hello world" < x
