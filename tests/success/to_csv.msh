# toCsvCell: plain string, no escaping needed
"hello" toCsvCell wl

# toCsvCell: empty string
"" toCsvCell wl

# toCsvCell: contains comma
"a,b" toCsvCell wl

# toCsvCell: contains newline
"a\nb" toCsvCell wl

# toCsvCell: contains double quote
"a\"b" toCsvCell wl

# toCsvCell: contains comma and double quote
"a,\"b" toCsvCell wl

# toCsv: simple rows
[["a" "b" "c"] ["d" "e" "f"]] toCsv w

# toCsv: single row
[["x" "y"]] toCsv w

# toCsv: cells needing escaping
[["a,b" "c\"d" "plain"] ["line1\nline2" "ok" ""]] toCsv w

# toCsv: grid with int, float, string, and bool columns
[| id, "name, full", score, ok; 1, "Ada", 2.5, true; 2, "B \"Bo\"", 10.0, false |] g!
@g toCsv w

# toCsv: grid view keeps only the viewed rows
@g (:id? 1 >) filter toCsv w

# toCsv: none is an empty cell, just v is v, other values use their str form
[| a; 1; 2; 3 |] "b" [none 5 just [1 2]] gridAddCol toCsv w

# toCsv: a grid with no rows is just the header
[| a, b; 1, 2 |] (:a? 5 >) filter gridCompact toCsv w

# toCsv: round trip through parseCsv and toGrid
"x,y\n1,\"a,b\"\n3,4\n" parseCsv toGrid toCsv w

# toCsv: a date-time column is written in its ISO 8601 form
[| when, n; 2024-01-02T03:04:05, 1; 2025-11-30, 2 |] toCsv w

# toCsv: round trip of more rows than the size estimate samples
100 seq (i! [@i str "a,\"b\""]) map rows!
@rows toCsv parseCsv toJson @rows toJson = str wl
[["n" "s"]] @rows + toGrid big!
@big toCsv lines len wl
@big toCsv parseCsv toGrid toCsv @big toCsv = str wl
