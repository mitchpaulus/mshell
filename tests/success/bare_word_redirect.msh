# A bare word in a list literal is a string, exactly as if it were quoted.
[ls] :0: typeof wl
[echo "x"] (match str s : "str" wl, _ : "other" wl, end) each

# '>' takes a string as a file name.
[bare_word_redirect_out.txt] :0: outFile!
("from quote" wl) @outFile > x
`bare_word_redirect_out.txt` readFile w
`bare_word_redirect_out.txt` rm

# '<' takes a string as the input text, and a path as a file to read.
[bare_word_redirect.msh] :0: input!
(stdin wl) @input < x
[head -n 1] `bare_word_redirect.msh` < ;

# Directly in a list literal too: the text bare_word_redirect.msh, 22 characters.
[echo [wc -c] bare_word_redirect.msh < * !] !
