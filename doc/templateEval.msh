# Render a template from stdin, replacing ⟦ ... ⟧ with the stdout of executing the enclosed mshell code.
def render (str -- str)
    template!
    @template "⟦" splitOnce match
        just open :
            @open => [prefix rest]
            @rest "⟧" splitOnce match
                just close :
                    @close => [code after]
                    @prefix [msh "-c" @code] * ! + @after render +,
                none : @template,
            end,
        none : @template,
    end
end

stdin render w
