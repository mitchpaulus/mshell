diff --git a/mshell/TypeStats.go b/mshell/TypeStats.go
new file mode 100644
index 00000000..a2952d16
--- /dev/null
+++ b/mshell/TypeStats.go
@@ -0,0 +1,116 @@
+package main
+
+// TEMPORARY stage-0 measurement counters (ai/type-system-plan.md, stage 0).
+// Not to be committed. Active only when MSH_TC_STATS names an output file;
+// each event is appended as one tab-separated line: kind, position, detail.
+
+import (
+	"fmt"
+	"os"
+	"strings"
+)
+
+var statOut *os.File
+var statCurTok Token
+var statNext string
+var statQuoteCtx []string
+
+func init() {
+	if p := os.Getenv("MSH_TC_STATS"); p != "" {
+		f, err := os.OpenFile(p, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+		if err == nil {
+			statOut = f
+		}
+	}
+}
+
+func statPos(t Token) string {
+	file := os.Getenv("MSH_TC_FILE")
+	if t.TokenFile != nil {
+		file = t.TokenFile.Path
+	}
+	return fmt.Sprintf("%s:%d:%d", file, t.Line, t.Column)
+}
+
+func stat(kind string, t Token, format string, args ...any) {
+	if statOut == nil {
+		return
+	}
+	detail := strings.ReplaceAll(fmt.Sprintf(format, args...), "\n", " ")
+	fmt.Fprintf(statOut, "%s\t%s\t%s\n", kind, statPos(t), detail)
+}
+
+// statDescribeNext names the first item after body[i] that is not a quote
+// literal, so `(a) (b) iff` reports `iff` for both quotes.
+func statDescribeNext(body []MShellParseItem, i int) string {
+	skipped := 0
+	for j := i + 1; j < len(body); j++ {
+		switch it := body[j].(type) {
+		case *MShellParseQuote:
+			skipped++
+			continue
+		case Token:
+			return fmt.Sprintf("%s(+%dq)", it.Lexeme, skipped)
+		case MShellVarstoreList:
+			return fmt.Sprintf("STORE(+%dq)", skipped)
+		default:
+			return fmt.Sprintf("%T(+%dq)", it, skipped)
+		}
+	}
+	return fmt.Sprintf("<end>(+%dq)", skipped)
+}
+
+func (c *Checker) statType(t TypeId) string {
+	return FormatType(c.arena, c.names, c.subst.Apply(c.arena, t))
+}
+
+// statCast classifies an `as` before castTop runs, probing each path on a
+// substitution checkpoint.
+func (c *Checker) statCast(target TypeId, tok Token, fresh, deep bool) {
+	if statOut == nil || c.stack.Len() == 0 {
+		return
+	}
+	src := c.subst.Apply(c.arena, c.stack.items[c.stack.Len()-1])
+	dst := c.subst.Apply(c.arena, target)
+	cp := c.subst.Checkpoint()
+	path := "fail"
+	switch {
+	case src == dst:
+		path = "equal"
+	case func() bool { ok := c.unify(src, dst); c.subst.Rollback(cp); return ok }():
+		path = "unify"
+	case func() bool { ok := c.castOk(src, dst); c.subst.Rollback(cp); return ok }():
+		path = "brand"
+	case fresh && func() bool { ok := c.freshWidenOk(src, dst, deep); c.subst.Rollback(cp); return ok }():
+		path = "freshwiden"
+	}
+	c.subst.Rollback(cp)
+	stat("as", tok, "path=%s fresh=%v deep=%v inferring=%v src=%s dst=%s", path, fresh, deep, c.inferring,
+		FormatType(c.arena, c.names, src), FormatType(c.arena, c.names, dst))
+}
+
+func (c *Checker) statStore(name NameId, t TypeId, tok Token, what string) {
+	if statOut == nil {
+		return
+	}
+	old, ok := c.vars.bound[name]
+	if !ok {
+		old, ok = c.vars.maybeBound[name]
+	}
+	if !ok {
+		return
+	}
+	a := c.subst.Apply(c.arena, old)
+	b := c.subst.Apply(c.arena, t)
+	if a == b {
+		return
+	}
+	cp := c.subst.Checkpoint()
+	saved := c.readOnlyArgs
+	c.readOnlyArgs = false
+	unifiable := c.unify(a, b) && c.unify(b, a)
+	c.readOnlyArgs = saved
+	c.subst.Rollback(cp)
+	stat("var_retype", tok, "%s name=%s unifiable=%v inferring=%v old=%s new=%s", what, c.names.Name(name), unifiable, c.inferring,
+		FormatType(c.arena, c.names, a), FormatType(c.arena, c.names, b))
+}
