# The personal key bindings that were compiled into the shell before
# user-defined bindings (ai/cli_bindings.typ, section 11).
# Paste into ~/dotfiles/.config/msh/init.msh, after the definitions of `r` and `j`.
#
# What changes from the compiled-in versions:
# - The first key of each pair appears as it is typed, and is taken back when the pair completes.
# - `;r`, `;j` and F1 keep the line you were typing, and no longer add `r`, `j` or `lf` to history.
# - `qq` leaves through editExit instead of running `0 exit`.
# - idleBefore makes `devlog` and `qqq` typeable when typed at speed; tune the values by use.

# Enter.
{keys: [r'j' r'f'], action: [editAccept] bindingOps} bindingAdd

# Clear the screen.
{keys: [r'v' r'l'], action: [editClearScreen] bindingOps, idleBefore: 150} bindingAdd

# Leave the shell.
{keys: [r'q' r'q'], action: [editExit] bindingOps, idleBefore: 150} bindingAdd

# The file manager on $REPOS and $JOBSDIR (the defs `r` and `j` above).
{keys: [r';' r'r'], action: [(r) editRun] bindingOps} bindingAdd
{keys: [r';' r'j'], action: [(j) editRun] bindingOps} bindingAdd

# lf on F1.
{keys: [keyF1], action: [([lf];) editRun] bindingOps} bindingAdd

# Today's date (YYYY-MM-DD) at the cursor on Alt-D.
def insertDate (EditState -- new Maybe[[EditOp]])
    drop [now isoDateFmt editInsert] just
end
{keys: [r'd' keyAlt], action: (insertDate) bindingFunc} bindingAdd
