+/// A socket already connected to the compositor (mshell startup patch).
+pub(crate) static PRECONNECTED: std::sync::Mutex<Option<std::os::unix::net::UnixStream>> =
+    std::sync::Mutex::new(None);
+
+/// Use `stream`, already connected to the compositor, for the next Wayland
+/// event loop instead of connecting then (mshell startup patch). Connecting
+/// early lets the compositor start on its per-client setup sooner, and
+/// unlike `WAYLAND_SOCKET` it doesn't touch the environment, which other
+/// threads may be reading.
+pub fn set_preconnected_socket(stream: std::os::unix::net::UnixStream) {
+    *PRECONNECTED.lock().unwrap() = Some(stream);
+}
