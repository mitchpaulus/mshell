# fd {{{
def __fdDefaultOptions ( -- [str])
    [
        '-h' '--help' '-V' '--version' '-H' '--hidden' '-I' '--no-ignore' '-u' '--unrestricted'
        '-g' '--glob' '-t' '--type' '-e' '--extension' '-x' '--exec' '-X' '--exec-batch'
        '-E' '--exclude' '-p' '--full-path' '-a' '--absolute-path' '-L' '--follow'
        '-d' '--max-depth' '--min-depth' '-S' '--size' '-s' '--case-sensitive' '-i' '--ignore-case'
        '-c' '--color' '--threads' '--base-directory' '--path-separator' '--ignore-file'
        '--one-file-system' '--changed-within' '--changed-before' '--max-results'
        '--strip-cwd-prefix'
    ]
end

def __fdCompletion { 'complete': ['fd'] } ([str] str -- [str])
    prefix! input!
    @input len 0 > if @input :-1: else '' end match
        '-t' '--type' : ['file' 'directory' 'symlink' 'executable' 'empty' 'socket' 'pipe' 'char-device' 'block-device'],
        '-c' '--color' : ['auto' 'always' 'never'],
        '--base-directory' '--search-path' : @prefix completeDirs,
        '--ignore-file' : @prefix completeFiles,
        '-x' '--exec' '-X' '--exec-batch' : @prefix completeBinaries,
        '-e' '--extension' '-E' '--exclude' '-d' '--max-depth' '--min-depth' '-S' '--size' '--threads'
        '--path-separator' '--changed-within' '--changed-before' '--max-results' : [] as [str],
        _ : @prefix '-' startsWith (__fdDefaultOptions) (@prefix completeFiles) iff,
    end
end
# }}}
# ssh {{{
def __sshHosts ( -- [str])
    # Parse ~/.ssh/config for Host entries
    $"{$HOME}/.ssh/config" configPath!
    @configPath fileExists if
        @configPath readFile lines
        (trim) map
        (lower "host " startsWith) filter
        (5:) map # Remove "Host " prefix
        (wsplit) map concat # Split on whitespace for multiple hosts per line
        ("*" in not) filter # Remove wildcard entries
    else
        []
    end
end

def __sshDefaultOptions ( -- [str])
    [
        '-4' '-6' '-A' '-a' '-B' '-b' '-C' '-c' '-D' '-E' '-e' '-F' '-f' '-G' '-g'
        '-I' '-i' '-J' '-K' '-k' '-L' '-l' '-M' '-m' '-N' '-n' '-O' '-o' '-P' '-p'
        '-Q' '-q' '-R' '-S' '-s' '-T' '-t' '-V' '-v' '-W' '-w' '-X' '-x' '-Y' '-y'
    ]
end

def __sshOptionArgs ( -- {[str]})
    {
        '-c': ['aes128-ctr' 'aes192-ctr' 'aes256-ctr' 'aes128-gcm@openssh.com' 'aes256-gcm@openssh.com' 'chacha20-poly1305@openssh.com'],
        '-e': ['^' 'none'],
        '-m': ['hmac-sha2-256' 'hmac-sha2-512' 'umac-64@openssh.com' 'umac-128@openssh.com' 'hmac-sha2-256-etm@openssh.com' 'hmac-sha2-512-etm@openssh.com' 'umac-64-etm@openssh.com' 'umac-128-etm@openssh.com'],
        '-O': ['check' 'forward' 'cancel' 'exit' 'stop'],
        '-o': ['AddKeysToAgent' 'BatchMode' 'BindAddress' 'CanonicalDomains' 'Compression' 'ConnectionAttempts' 'ConnectTimeout' 'ForwardAgent' 'ForwardX11' 'HostKeyAlgorithms' 'IdentityFile' 'LogLevel' 'PreferredAuthentications' 'ProxyCommand' 'ProxyJump' 'PubkeyAuthentication' 'ServerAliveInterval' 'StrictHostKeyChecking' 'UserKnownHostsFile'],
        '-Q': ['cipher' 'cipher-auth' 'help' 'mac' 'kex' 'kex-gss' 'key' 'key-ca-sign' 'key-cert' 'key-plain' 'key-sig' 'protocol-version' 'sig']
    }
end

def __sshCompletion { 'complete': ['ssh'] } ([str] str -- [str])
    prefix! input!
    @input len 0 > if @input :-1: else '' end last!
    @last match
        # -J (jump host) needs dynamic lookup
        '-J' : __sshHosts,
        '-i' '-F' '-E' '-S' : @prefix completeFiles,
        _ : __sshOptionArgs @last get match
            just values : @values,
            none : @prefix '-' startsWith (__sshDefaultOptions) (__sshHosts) iff,
        end,
    end
end
