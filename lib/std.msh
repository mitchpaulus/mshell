# rg {{{
def __rgDefaultOptions ( -- [str])
    [
        '-h' '--help' '--version' '-g' '--glob' '-F' '--fixed-strings' '-e' '--regexp'
        '-i' '--ignore-case' '-S' '--smart-case' '-s' '--case-sensitive' '-U' '--multiline'
        '-u' '--unrestricted' '-w' '--word-regexp' '-x' '--line-regexp'
        '-v' '--invert-match' '-c' '--count' '-l' '--files-with-matches'
        '--files-without-match' '--files' '--no-messages' '--follow' '--hidden' '--no-ignore'
        '--one-file-system' '-t' '--type' '-T' '--type-not' '--type-add'
        '--glob-case-insensitive' '-C' '--context' '-B' '--before-context' '-A' '--after-context'
        '-m' '--max-count' '--max-depth' '--max-filesize' '--max-columns' '--max-columns-preview'
        '--mmap' '--no-mmap' '--threads' '--pcre2' '--no-pcre2'
        '--color' '--colors' '--heading' '-n' '--line-number' '--column' '--no-line-number'
        '-H' '--with-filename' '--no-filename' '--no-heading' '--json'
        '--sort' '--sortr' '--type-list'
    ]
end

def __rgCompletion { 'complete': ['rg'] } ([str] str -- [str])
    prefix! input!
    @input len 0 > if @input :-1: else '' end match
        '-t' '--type' '-T' '--type-not' : ['rg' '--type-list'] * ; lines (":" split :0:) map,
        '--color' : ['auto' 'always' 'never'],
        '-f' '--file' '--ignore-file' : @prefix completeFiles,
        '-g' '--glob' '-e' '--regexp' '-C' '--context' '-B' '--before-context' '-A' '--after-context'
        '-m' '--max-count' '--max-depth' '--max-filesize' '--max-columns' '--threads' '--colors'
        '--sort' '--sortr' '--type-add' : [] as [str],
        _ : @prefix '-' startsWith (__rgDefaultOptions) (@prefix completeFiles) iff,
    end
end
# }}}
# sudo {{{
def __sudoCompletion { 'complete': ['sudo'] } ([str] str -- [str])
    prefix! input!
    ['-A' '--askpass' '-b' '--background' '-E' '--preserve-env'
     '-H' '--set-home' '-i' '--login' '-K' '--remove-timestamp'
     '-k' '--reset-timestamp' '-l' '--list' '-n' '--non-interactive'
     '-P' '--preserve-groups' '-S' '--stdin' '-s' '--shell'
     '-V' '--version' '-v' '--validate'] noArgOptions!

    ['-C' '--close-from' '-g' '--group' '-h' '--host'
     '-p' '--prompt' '-u' '--user' '-U' '--other-user'
     '-T' '--command-timeout'] argOptions!

    # Walk through input to find the command (first non-option, non-option-value token)
    0 i!
    false skipNext!
    [] as [str] commandLine!
    @input len inputLen!

    (
        @i @inputLen >= if break end
        @input @i nth tok!
        @skipNext if
            false skipNext!
        else
            @commandLine len 0 > if
                @commandLine @tok append drop
            else
                @argOptions (@tok =) any if
                    true skipNext!
                else* @tok "-" startsWith *if
                    # Option without a value, or an unknown option
                else
                    @commandLine @tok append drop
                end
            end
        end
        @i 1 + i!
    ) loop

    @commandLine len 0 > if
        # Complete the command's own arguments.
        @commandLine @prefix completeCommand
    else* @skipNext *if
        # The value of an option like -u
        [] as [str]
    else* @prefix '-' startsWith *if
        @noArgOptions @argOptions extend
    else
        @prefix completeBinaries
    end
end
# }}}
# systemctl {{{
def __systemctlCompletion { 'complete': ['systemctl'] } ([str] str -- [str])
    prefix! input!
    ['list-units' 'list-sockets' 'start' 'stop' 'reload' 'restart'
     'try-restart' 'reload-or-restart' 'reload-or-try-restart' 'try-reload-or-restart'
     'isolate' 'kill' 'is-active' 'is-failed' 'status' 'show' 'cat' 'edit'
     'help' 'reset-failed' 'list-unit-files' 'enable' 'disable' 'is-enabled'
     'reenable' 'preset' 'mask' 'unmask' 'link' 'load' 'list-jobs' 'cancel'
     'dump' 'list-dependencies' 'snapshot' 'delete' 'daemon-reload' 'daemon-reexec'
     'show-environment' 'set-environment' 'unset-environment'
     'default' 'rescue' 'emergency' 'halt' 'poweroff' 'reboot' 'kexec' 'exit'
     'suspend' 'suspend-then-hibernate' 'hibernate' 'hybrid-sleep' 'switch-root'
     'list-timers' 'set-property' 'import-environment' 'get-default' 'set-default'
     'list-automounts' 'is-system-running' 'freeze' 'thaw'
     'mount-image' 'bind' 'clean'] subcommands!

    ['start' 'stop' 'reload' 'restart' 'try-restart'
     'reload-or-restart' 'reload-or-try-restart' 'try-reload-or-restart'
     'isolate' 'kill' 'is-active' 'is-failed' 'status' 'show' 'cat' 'edit'
     'help' 'reset-failed' 'enable' 'disable' 'is-enabled' 'reenable'
     'preset' 'mask' 'unmask' 'freeze' 'thaw' 'clean'
     'list-dependencies' 'set-property'] unitCommands!

    ['--all' '--recursive' '--reverse' '--after' '--before'
     '--full' '--show-types' '--no-block' '--no-legend' '--no-pager'
     '--no-wall' '--no-reload' '--no-ask-password' '--failed'
     '--runtime' '--plain' '--now' '--firmware-setup'
     '-a' '-r' '-l' '-f' '-q' '-h' '--help' '--version'] noArgOptions!

    ['-t' '--type' '--state' '-p' '--property' '--job-mode'
     '-n' '--lines' '-o' '--output' '-H' '--host'
     '-M' '--machine' '-s' '--signal' '--kill-who'
     '--root' '--boot-loader-entry' '--boot-loader-menu'] argOptions!

    # Find the subcommand
    0 i!
    false skipNext!
    "" subcmd!
    @input len inputLen!

    (
        @i @inputLen >= if break end
        @input @i nth tok!
        @skipNext if
            false skipNext!
        else
            @subcmd len 0 > if
                break
            else
                @argOptions (@tok =) any if
                    true skipNext!
                else* @noArgOptions (@tok =) any *if
                    # skip
                else* @tok "--user" = @tok "--system" = or @tok "--global" = or *if
                    # skip, these are standalone flags
                else* @tok "-" startsWith *if
                    # Unknown option, skip
                else
                    @tok subcmd!
                end
            end
        end
        @i 1 + i!
    ) loop

    @prefix '-' startsWith if
        @noArgOptions @argOptions extend
    else* @subcmd len 0 = *if
        @subcommands
    else* @unitCommands (@subcmd =) any *if
        # Unit names for commands that operate on units
        ['systemctl' 'list-unit-files' '--no-legend' '--no-pager'] * ;
        lines (" " split :0:) map
    else
        [] as [str]
    end
end
