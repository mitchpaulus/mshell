        'check' :
            [
                '--fix' '--all-packages' '--package' '--script' '--extra' '--all-extras'
                '--no-extra' '--no-dev' '--only-dev' '--group' '--no-group' '--no-default-groups'
                '--only-group' '--all-groups' '--locked' '--frozen' '--no-sync'
