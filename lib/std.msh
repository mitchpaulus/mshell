# Standard library for mshell

# type numeric int | float

def chunk ([a] int -- [[a]])
    [] chunkAcc
end

def chunkAcc([a] int [[a]] -- [[a]])
    list!, n!, acc!
    @list len 0 <= if
        @acc
    else
        @list @n skip # new list
        @n # chunk size
        @acc @list @n take append # accumulator
        chunkAcc
    end
end

def toCsvCell (str -- str)
    s!
    @s "," in or. @s "\n" in end or. @s '"' in end if
        @s '"' '""' findReplace content!
        $"\"{@content}\""
    else
        @s
    end
end

def toCsv ([[str]] -- str)
    map. map. toCsvCell end "," join end unlines
end

def enumerate ([a] -- [{"item": a, "index": int }])
    dup len seq (a!, i! { "item": @a, "index": @i }) zip
end

def enumerateN ([a] int -- [{"item": a, "index": int }])
    start! dup len seq (@start +) map (a!, i! { "item": @a, "index": @i }) zip
end

def 2each (T T (T -- b) -- b b)
    dup # o1 o2 q1 q2
    -rot # o1 q2 o2 q1
    x # o1 q2 r2
    -rot # r2 o1 q2
    x # r2 r1
    swap # r1 r2
end

def 2unpack ([a] -- a a)
    dup :0: swap :1:
end

def 2apply ([a] (a a -- c) -- c)
    swap 2unpack rot x
end

# Identity quotes — useful as a no-op value selector for things like
# `listToDict`, where you want to keep the element as-is.
def id (T -- T) end
def 2id (T1 T2 -- T1 T2) end
def 3id (T1 T2 T3 -- T1 T2 T3) end

def eachWhile ([T] (T -- bool) --)
    over len each-len! # Get total length
    0 each-idx! # index
    (
        @each-idx @each-len >= if
            break
        end
        # "Each idx: " w @each-idx w " Each len: " w @each-len wl
        over @each-idx nth # Get current item
        over x  # Copy over quote, execute
        not (break) iff
        @each-idx 1 + each-idx! # inc index
        # "Each idx: " w @each-idx wl
    ) loop

    # Drop list and quote, total length, index
    drop drop
end

def takeWhile ([T] (T -- bool) -- [T])
    list!, quote!
    [] takeWhile-result!
    0 takeWhile-idx!
    (
        @takeWhile-idx @list len >= (break) iff
        @list @takeWhile-idx nth takeWhile-item!
        @takeWhile-item @quote x not (break) iff
        @takeWhile-result @takeWhile-item append drop
        @takeWhile-idx 1 + takeWhile-idx!
    ) loop
    @takeWhile-result
end

def dropWhile ([T] (T -- bool) -- [T])
    list!, quote!
    0 dropWhile-idx!
    (
        @dropWhile-idx @list len >= (break) iff
        @list @dropWhile-idx nth dropWhile-item!
        @dropWhile-item @quote x not (break) iff
        @dropWhile-idx 1 + dropWhile-idx!
    ) loop
    @list @dropWhile-idx skip
end

def linearSearch ([T] (T -- bool) -- Maybe[T])
    list!, quote!
    none linearSearch-result!
    0 linearSearch-idx!
    (
        @linearSearch-idx @list len >= (break) iff
        @list @linearSearch-idx nth linearSearch-item!
        @linearSearch-item @quote x if
            @linearSearch-item just linearSearch-result!
            break
        end
        @linearSearch-idx 1 + linearSearch-idx!
    ) loop
    @linearSearch-result
end

def linearSearchIndex ([T] (T -- bool) -- Maybe[int])
    list!, quote!
    none linearSearchIndex-result!
    0 linearSearchIndex-idx!
    (
        @linearSearchIndex-idx @list len >= (break) iff

        @list @linearSearchIndex-idx nth @quote x if
            @linearSearchIndex-idx just linearSearchIndex-result!
            break
        end
        @linearSearchIndex-idx 1 + linearSearchIndex-idx!
    ) loop
    @linearSearchIndex-result
end

# foldl (quote initial list -- result)
def foldl ((T T -- T) T [T] -- T)
    #  quote initial list
    swap foldl-accum!  # Accumulator,
    # quote list
    swap foldl-quote! # Quote
    # list
    (
        @foldl-accum swap # Accumulator item
        @foldl-quote x # Execute quote
        foldl-accum! # Update accumulator
    ) each

    @foldl-accum
end

# sumInt retained as an alias for backwards compatibility; the primary
# `sum` is now a runtime builtin that handles both [int] and [float].
def sumInt ([int] -- int) sum end

# [s]tdin [l]ines
def sl (-- [str]) stdin lines end

def ttFile (str|path -- [[str]])
    readFile lines (tab split) map
end

# wt = Whitespace separated Table (-- [[str*]*])
def wt (-- [[str]]) sl (wsplit) map  end

def wtFile (str -- [[str]])
    readFile lines (wsplit) map
end

# wjoin = Whitespace join ([str*] -- str)
def wjoin ([str] -- str) " " join end

# unlines (list[str] -- str)
def unlines ([str] -- str)
    [] unlines-accum! # Accumulator
    (
       @unlines-accum swap append
       "\n" append
       drop
    ) each
    @unlines-accum "" join
end

# unlinesCrLf (list[str] -- str)
def unlinesCrLf ([str] -- str)
    [] unlines-accum! # Accumulator
    (
       @unlines-accum swap append
       "\r\n" append
       drop
    ) each
    @unlines-accum "" join
end


# chomp (str -- str)
# Strip a single trailing newline. Handles both \n and \r\n.
def chomp (str -- str)
    dup "\r\n" endsWith if
        :-2
    else* dup "\n" endsWith *if
        :-1
    end
end

# longestCommonPrefix ([str] -- str)
# Longest leading substring shared by every string in the list.
# Byte-based, like the other string functions. Empty list gives "".
def longestCommonPrefix ([str] -- str)
    lcp-list!
    @lcp-list len 0 = if
        ""
    else
        @lcp-list :0: lcp-prefix!
        @lcp-list 1: (
            lcp-item!
            (
                @lcp-item @lcp-prefix startsWith (break) iff
                @lcp-prefix :-1 lcp-prefix!
            ) loop
        ) each
        @lcp-prefix
    end
end

# `abs` is now a runtime builtin (int -- int) | (float -- float).

# This uses the Marsaglia polar method
# https://en.wikipedia.org/wiki/Marsaglia_polar_method
def randomNorm (-- float)
    (
        random 2.0 * 1.0 - u!
        random 2.0 * 1.0 - v!
        @u dup * @v dup * + s!
        @s 0.0 > @s 1.0 < and if
            # u * sqrt( (-2 * ln(s) / s )
            @s ln -2.0 * @s / sqrt
            @u * out! break
        end
    ) loop
    @out
end

# Min, Mode, Max.
# https://en.wikipedia.org/wiki/Triangular_distribution
def randomTri (float float float -- float)
    a!, c!, b!
    @a toFloat a! @b toFloat b! @c toFloat c!
    @c @a - @b @a - / f!
    random u!
    @u @f < if
        @u
        @b @a -
        @c @a -
        * * sqrt
        @a +
    else
        @b
            1.0 @u -
            @b @a -
            @b @c -
            * * sqrt
        -
    end
end

def cos (float -- float)
    1.5707963267948966 + sin
end

def tan (float -- float)
    dup sin swap cos /
end

def ln2 (float -- float)
    ln 1.4426950408889634 *
end

def ln10 (float -- float)
    ln 0.4342944819032518 *
end


def tab (-- str) "	" end
def tsplit (str -- [str])  tab split end
def tjoin ([str] -- str)  tab join end

def cjoin ([str] -- str) "," join end

# Build an SVG path "d" string from [x y] pairs.
def toSvgPathStr ([[numeric]] -- str)
    points!
    @points len 0 = if
        ""
    else
        @points :0: first!
        @points 1 skip rest!
        [$"M {@points :0: :0: str} {@points :0: :1: str}"]
        @rest map. r! $"L {@r :0: str} {@r :1: str}" end
        extend " " join
    end
end

def scaleLinear ([float] [float] -- (float -- float))
    domain!, range! @domain 2unpack d0!, d1! @range 2unpack r0!, r1!
    @r1 @r0 - toFloat @d1 @d0 toFloat - / slope!
    (@d0 - @slope * @r0 +)
end

def uw ([str] --) unlines w end
# tuw = tab unlines write
def tuw ([[str]] -- ) (tjoin) map uw end

def readTsvFile (str | path -- [[str]])
    readFile lines (tsplit) map
end

# `max`, `min`, `max2`, `min2` are now runtime builtins with proper
# int/float overload handling.

# This also works for non-square matrices, swapping row-major for column-major
# Horribly inefficient, but it works
def transpose ([[a]] -- [[a]])
    list! @list (len) map max colmax!
    @list len numrows!
    [] transpose-accum!
    0 colIndex!
    (
        @colIndex @colmax >= if break end
        0 rowIndex!
        [] inner-accum!
        (
            @rowIndex @numrows >= if break end
            @list @rowIndex nth curRow!
            @curRow len @colIndex > if
                @inner-accum @curRow @colIndex nth append drop
            end
            @rowIndex 1 + rowIndex!
        ) loop

        @transpose-accum @inner-accum append drop
        @colIndex 1 + colIndex!
    ) loop

    @transpose-accum
end

def any ([T] (T -- bool) -- bool)
    list!, quote!
    0 index!
    @list len listLength!
    false result!
    (
        @index @listLength >= if
            break
        else
            @list @index nth @quote x
            (true result! break)
            iff
        end
        @index 1 + index!
    ) loop
    @result
end

def all ([T] (T -- bool) -- bool)
    quote! (@quote x not) any not
end

def isoDateFmt (date -- str)
    "2006-01-02" dateFmt
end

def isoDateTimeFmt (date -- str)
    "2006-01-02T15:04:05" dateFmt
end

def zip ([a] [b] (a b -- c) -- [c])
    list1!, list2!, quote!
    @list1 len @list2 len min2 length!
    0 index!
    [] accum!
    (
        @index @length >= (break) iff
        @accum
        @list1 @index nth
        @list2 @index nth
        @quote x
        append
        drop
        @index 1 + index!
    ) loop
    @accum
end

def repeat (a int -- [a])
    item!, count!
    @count seq (drop @item) map
end

def htmlDescendents (dict -- [dict])
    [] htmlDescendentsAcc
end

# Accumulator version
def htmlDescendentsAcc (dict [dict] -- [dict])
    node!, accum!
    @node "children" get? (c! @c @accum htmlDescendentsAcc drop) each
    @accum @node append
end

def findByTag (dict str -- [dict])
  tag! htmlDescendents ("tag" get (@tag =) map false maybe) filter
end

def concat ([[a]] -- [a])
    # Use `extend` (in-place append) rather than `+` so we accumulate into a
    # single freshly-allocated seed list instead of allocating a new list at
    # every fold step. The `[]` seed is private to this call so mutation is
    # safe; the input sublists are unmodified.
    l! (extend) [] @l foldl
end

# This is a better form from a typing perspective, because it allows for chaining
# Can get it started with an identity list [[]]
def cartesian ([[a]] [a] -- [[a]])
    listA!, listB!
    @listA map.
        a!
        @listB map.
            # Need to force new list object with '+', 'extend' won't work here.
            b! @a [@b] +
        end
    end
    concat
end

def listToDict ([a] (a -- str) (a -- b) -- c)
    l!, keyFunc!, valFunc!
    {} d!
    @l
    (
        item!
        @item @keyFunc x key!
        @item @valFunc x value!
        @d @key @value set drop
    )
    each
    @d
end

def 2tuple (a b -- [a | b])
    [] rot append swap append
end

def whenJust (Maybe[T] (T -- ) -- ) f! match just v: @v @f x, _: end end

# Integer base formatting/parsing. The integer itself never records a base;
# these wrap the generic `toBase`/`fromBase` builtins for the common bases.
# Output is bare digits (no 0o/0x/0b prefix); parsing accepts an optional
# matching prefix, so both "0o644" and "644" work with parseOctal.
def toHex (int -- str) 16 toBase end
def toOctal (int -- str) 8 toBase end
def toBin (int -- str) 2 toBase end

def parseHex (str -- Maybe[int]) 16 fromBase end
def parseOctal (str -- Maybe[int]) 8 fromBase end
def parseBin (str -- Maybe[int]) 2 fromBase end

# COMPLETIONS {{{
# msh {{{
def __mshCompletion { 'complete': ['msh' 'mshell'] } ([str] str -- [str])
    prefix! input!
    @input len 0 > if
        @input len 1 = firstArgument!
        @input :0: match
            'lsp' : [] as [str],
            'bin' : @firstArgument
                (['add' 'remove' 'list' 'path' 'edit' 'audit' 'debug'])
                (@input :1: 'add' = (@prefix completeFiles) ([] as [str]) iff) iff,
            'edit' : @firstArgument (['init']) ([] as [str]) iff,
            'completions' : @firstArgument (['fish' 'bash' 'nushell' 'elvish']) ([] as [str]) iff,
            # Everything else is a script and its arguments.
            _ : @prefix completeFiles,
        end
    else* @prefix '-' startsWith *if
        ['-h' '--help' '--html' '--lex' '--parse' '--check-types' '--type-check-only' '--version' '-c' '-']
    else
        ['lsp' 'bin' 'edit' 'completions'] @prefix completeFiles extend
    end
end
