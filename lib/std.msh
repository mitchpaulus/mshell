# Default completions after a subcommand: common options plus the subcommand-specific ones.
def __cargoSubcmdCompletions (str -- [str])
    cmd!
    __cargoCommonOptions @cmd __cargoOptionsForSubcmd extend
end

# Completions after a cargo subcommand when the previous word does not take a value.
def __cargoArguments (str str -- [str])
    prefix! subcmd!
    @prefix '-' startsWith if
        @subcmd __cargoSubcmdCompletions
    else
        @subcmd match
            'help'       : __cargoSubcommands,
            'uninstall'  : __cargoInstalled,
            'new' 'init' : @prefix completeDirs,
            _            : [] as [str],
        end
    end
end

def __cargoCompletion { 'complete': ['cargo'] } ([str] str -- [str])
    prefix! input!
    @input len 0 > if
        @input :0: match
            'b' : 'build',
            'c' : 'check',
            'r' : 'run',
            't' : 'test',
            'd' : 'doc',
            _   :> ,
        end subcmd!
        @input :-1: last!

        @last match
            '-p' '--package' '--exclude' : __cargoPackages,
            '--target'          : __cargoTargets,
            '--features'        : __cargoFeatures,
            '--color'           : ['auto' 'always' 'never'],
            '--vcs'             : ['git' 'hg' 'pijul' 'fossil' 'none'],
            '--edition'         : ['2015' '2018' '2021' '2024'],
            '--message-format'  : ['human' 'short' 'json' 'json-diagnostic-short' 'json-diagnostic-rendered-ansi' 'json-render-diagnostics'],
            '--profile'         : ['dev' 'release' 'test' 'bench'],
            '--manifest-path'   : @prefix completeFiles,
            '--target-dir' '--out-dir' '--root' '--path' : @prefix completeDirs,
            # --bin and --example take a target name in these subcommands, as do --test and --bench.
            '--bin' '--example' : @subcmd match
                'bench' 'build' 'check' 'run' 'rustc' 'test' : @last 2: __cargoTargetNames,
                _ : @subcmd @prefix __cargoArguments,
            end,
            '--test' '--bench'  : @subcmd match
                'bench' 'build' 'check' 'rustc' 'test' : @last 2: __cargoTargetNames,
                _ : @subcmd @prefix __cargoArguments,
            end,
            '-e' '--edges'      :
                @subcmd 'tree' =
                (['features' 'normal' 'build' 'dev' 'all' 'no-dev' 'no-build' 'no-normal'])
                (@subcmd @prefix __cargoArguments) iff,
            '--prefix'          :
                @subcmd 'tree' =
                (['depth' 'indent' 'none'])
                (@subcmd @prefix __cargoArguments) iff,
            '--charset'         :
                @subcmd 'tree' =
                (['utf8' 'ascii'])
                (@subcmd @prefix __cargoArguments) iff,
            _ : @subcmd @prefix __cargoArguments,
        end
    else* @prefix '-' startsWith *if
        ['--list' '--explain' '-C'] __cargoCommonOptions extend
    else
        __cargoSubcommands
    end
end
# }}}
# Subcommand paths {{{
# Walk the arguments of a command with nested subcommands, like `uv pip install`.
# `subcommands` gives the subcommands under a space-joined path, with '' for the top level.
# `alias` gives the subcommand an alias path stands for, or '' when it is not an alias.
# `takesValue` tells whether an option under a path consumes the next argument,
# so that value is not read as a subcommand.
# Leaves the subcommand path, then every argument from the first one that is not a subcommand.
def __subcommandPath ([str] (str -- [str]) (str -- str) (str str -- bool) -- [str] [str])
    takesValue! alias! subcommands! input!
    [] as [str] path!
    [] as [str] rest!
    '' pathKey!
    false skipNext!
    0 i!
    @input len n!
    (
        @i @n >= if break end
        @input @i nth tok!
        @i 1 + i!
        @rest len 0 > if
            @rest @tok append drop
        else* @skipNext *if
            false skipNext!
        else* @tok '-' startsWith *if
            @tok '=' in not if @pathKey @tok @takesValue x skipNext! end
        else
            @pathKey len 0 > if $"{@pathKey} {@tok}" else @tok end @alias x canonical!
            @pathKey @subcommands x (@tok =) any if
                @path @tok append drop
            else* @canonical len 0 > *if
                @path @canonical append drop
            else
                @rest @tok append drop
            end
            @path ' ' join pathKey!
        end
    ) loop
    @path @rest
end

# The part of a completion prefix up to and including its last path separator.
def __completionDir (str -- str)
    '[^/\\]*$' '' reReplace
end
# }}}
# redo {{{
# Whether a directory is a redo project root: it has .git or .redom/redo-msh.db.
def __redoIsRoot (path -- bool)
    dir!
    @dir '.git' toPath / fileExists
    @dir '.redom' toPath / 'redo-msh.db' toPath / isFile or
end

# Extensions of the `default.ext.do` rules above a directory that apply to it:
# rules in each parent directory up to the redo project root.
def __redoParentRuleExts (str -- [str])
    dir!
    @dir len 0 = ('.') (@dir) iff toPath absPath current!
    [] as [str] exts!
    (
        @current __redoIsRoot if break end
        @current dirname parent!
        # The filesystem root is its own parent.
        @parent str @current str = if break end
        @parent current!
        @exts @current 'default.*.do' toPath / str glob (basename stem str 8 skip) map extend drop
    ) loop
    @exts
end

# Targets redo can build in the directory the prefix names:
# `name` for each `name.do` there,
# and `name.ext` for each file `name.*` there and each `default.ext.do` rule that applies,
# where name stops at the file name's first period.
# So `plot.mplot` with `default.svg.do` gives `plot.svg`.
def __redoTargets (str -- [str])
    __completionDir dir!
    # One directory listing gives the .do files and the files the rules build from.
    @dir len start!
    @dir completeFiles
    (dup '/' endsWith swap '\' endsWith or not) filter
    (@start skip) map names!

    @names ('.do' endsWith) filter doFiles!
    @doFiles ('default.' startsWith not) filter (toPath stem str) map targets!
    # `default.do` matches every target, so it names no extension to build.
    @doFiles ('default.' startsWith) filter (toPath stem str 8 skip) map (len 0 >) filter
    @dir __redoParentRuleExts extend uniq exts!

    @exts len 0 > if
        @names ('.' startsWith not) filter ('.do' endsWith not) filter ('.' split :0:) map uniq
        (name! @exts (ext! $"{@name}.{@ext}") map) map concat
        @targets swap extend uniq targets!
    end
    @targets (target! $"{@dir}{@target}") map
end

def __redoCompletion { 'complete': ['redo'] } ([str] str -- [str])
    prefix! input!
    @input len 0 > if @input :-1: else '' end match
        # Job counts are not completed.
        '-j' '--jobs' : [] as [str],
        _ :
            @prefix '-' startsWith
            (['-j' '--jobs' '-y' '--yes' '-v' '--verbose' '--debug-jobs' '-h' '--help' '--version'])
            (@prefix __redoTargets @prefix completeDirs extend) iff,
    end
end
# }}}
# uv {{{
# Options accepted by every uv command.
def __uvGlobalOptions ( -- [str])
    [
        '-n' '--no-cache' '--cache-dir' '--managed-python' '--no-managed-python' '-q' '--quiet'
        '-v' '--verbose' '--color' '--system-certs' '--offline' '--allow-insecure-host'
        '--no-progress' '--directory' '--project' '--config-file' '-h' '--help'
    ]
end

# The "Index options" section of `uv help`, shared by the commands that resolve or install packages.
def __uvIndexOptions ( -- [str])
    [
        '--index' '--default-index' '-i' '--index-url' '--extra-index-url' '-f' '--find-links'
        '--no-index' '--index-strategy' '--keyring-provider'
    ]
end

# The "Resolver options" section of `uv help`, shared by the commands that resolve or install packages.
def __uvResolverOptions ( -- [str])
    [
        '-U' '--upgrade' '-P' '--upgrade-package' '--upgrade-group' '--resolution' '--prerelease'
        '--prerelease-package' '--fork-strategy' '--exclude-newer' '--exclude-newer-package'
        '--no-sources' '--no-sources-package'
    ]
end

# The "Build options" section of `uv help`, shared by the commands that resolve or install packages.
def __uvBuildOptions ( -- [str])
    [
        '-C' '--config-setting' '--config-settings-package' '--no-build-isolation'
        '--no-build-isolation-package' '--no-build' '--no-build-package' '--no-binary'
        '--no-binary-package'
    ]
end

# The "Installer options" section of `uv help`, shared by the commands that resolve or install packages.
def __uvInstallerOptions ( -- [str])
    ['--reinstall' '--reinstall-package' '--link-mode' '--compile-bytecode']
end

# The option lists of the named option groups.
def __uvGroupOptions (str -- [str])
    match
        'index' : __uvIndexOptions,
        'resolver' : __uvResolverOptions,
        'build' : __uvBuildOptions,
        'installer' : __uvInstallerOptions,
        _ : [] as [str],
    end
end

# Subcommands under a space-joined uv subcommand path; the top level is the empty string.
def __uvSubcommands (str -- [str])
    match
        '' :
            [
                'auth' 'run' 'init' 'add' 'remove' 'version' 'sync' 'lock' 'export' 'tree' 'format'
                'check' 'audit' 'tool' 'python' 'pip' 'venv' 'build' 'publish' 'workspace' 'cache'
                'self' 'help'
            ],
        'auth' : ['login' 'logout' 'token' 'dir'],
        'tool' : ['run' 'install' 'upgrade' 'list' 'audit' 'uninstall' 'update-shell' 'dir'],
        'python' : ['list' 'install' 'upgrade' 'find' 'pin' 'dir' 'uninstall' 'update-shell'],
        'pip' : ['compile' 'sync' 'install' 'uninstall' 'freeze' 'list' 'show' 'tree' 'check'],
        'workspace' : ['metadata' 'dir' 'list'],
        'cache' : ['clean' 'prune' 'dir' 'size'],
        'self' : ['update' 'version'],
        _ : [] as [str],
    end
end

# The option groups each subcommand accepts, by the names __uvGroupOptions takes.
def __uvOptionGroups (str -- [str])
    match
        'run' 'add' 'remove' 'version' 'sync' 'check' 'tool run' 'tool install' :
            ['index' 'resolver' 'build' 'installer'],
        'lock' 'export' 'build' 'workspace metadata' : ['index' 'resolver' 'build'],
        'tree' 'audit' 'pip compile' : ['index' 'resolver'],
        'tool upgrade' 'pip sync' : ['index' 'installer'],
        'pip install' : ['index' 'resolver' 'installer'],
        'pip list' 'pip tree' 'venv' : ['index'],
        _ : [] as [str],
    end
end

# Options of each subcommand beyond the global options and its option groups.
def __uvOwnOptions (str -- [str])
    match
        '' : ['--no-python-downloads' '--no-config' '-V' '--version'],
        'auth' 'auth dir' 'tool' 'tool update-shell' 'python' 'python update-shell' 'workspace'
        'cache' 'cache dir' 'self' :
            ['--no-python-downloads' '--no-config'],
        'auth login' :
            [
                '-u' '--username' '--password' '-t' '--token' '--keyring-provider'
                '--no-python-downloads' '--no-config'
            ],
        'auth logout' 'auth token' :
            ['-u' '--username' '--keyring-provider' '--no-python-downloads' '--no-config'],
        'run' :
            [
                '--extra' '--all-extras' '--no-extra' '--no-dev' '--only-dev' '--group'
                '--no-group' '--no-default-groups' '--only-group' '--all-groups' '-m' '--module'
                '--no-editable' '--no-editable-package' '--exact' '--env-file' '--no-env-file' '-w'
                '--with' '--with-editable' '--with-requirements' '--isolated' '--active'
                '--no-sync' '--locked' '--frozen' '-s' '--script' '--gui-script' '--all-packages'
                '--package' '--no-project' '--python-platform' '--refresh' '--refresh-package' '-p'
                '--python' '--no-python-downloads' '--no-config'
            ],
        'init' :
            [
                '--name' '--bare' '--package' '--no-package' '--app' '--lib' '--script'
                '--description' '--no-description' '--vcs' '--build-backend' '--no-readme'
                '--author-from' '--no-pin-python' '--no-workspace' '-p' '--python'
                '--no-python-downloads' '--no-config'
            ],
        'add' :
            [
                '-r' '--requirements' '-c' '--constraints' '-m' '--marker' '--dev' '--optional'
                '--group' '--editable' '--raw' '--bounds' '--rev' '--tag' '--branch' '--lfs'
                '--extra' '--no-sync' '--locked' '--frozen' '--active' '--package' '--script'
                '--workspace' '--no-workspace' '--no-install-project' '--no-install-workspace'
                '--no-install-local' '--no-install-package' '--refresh' '--refresh-package' '-p'
                '--python' '--no-python-downloads' '--no-config'
            ],
        'remove' :
            [
                '--dev' '--optional' '--group' '--no-sync' '--active' '--locked' '--frozen'
                '--package' '--script' '--refresh' '--refresh-package' '-p' '--python'
                '--no-python-downloads' '--no-config'
            ],
        'version' :
            [
                '--bump' '--dry-run' '--short' '--output-format' '--no-sync' '--active' '--locked'
                '--frozen' '--package' '--refresh' '--refresh-package' '-p' '--python'
                '--no-python-downloads' '--no-config'
            ],
        'sync' :
            [
                '--extra' '--output-format' '--all-extras' '--no-extra' '--no-dev' '--only-dev'
                '--group' '--no-group' '--no-default-groups' '--only-group' '--all-groups'
                '--no-editable' '--no-editable-package' '--inexact' '--active'
                '--no-install-project' '--no-install-workspace' '--no-install-local'
                '--no-install-package' '--locked' '--frozen' '--dry-run' '--all-packages'
                '--package' '--script' '--python-platform' '--check' '--refresh'
                '--refresh-package' '-p' '--python' '--no-python-downloads' '--no-config'
            ],
        'lock' :
            [
                '--check' '--check-exists' '--dry-run' '--script' '--link-mode' '--refresh'
                '--refresh-package' '-p' '--python' '--no-python-downloads' '--no-config'
            ],
        'export' :
            [
                '--format' '--all-packages' '--package' '--prune' '--extra' '--all-extras'
                '--no-extra' '--no-dev' '--only-dev' '--group' '--no-group' '--no-default-groups'
                '--only-group' '--all-groups' '--no-annotate' '--no-header' '--emit-index-url'
                '--emit-find-links' '--no-editable' '--no-editable-package' '--no-hashes' '-o'
                '--output-file' '--no-emit-project' '--no-emit-workspace' '--no-emit-local'
                '--no-emit-package' '--locked' '--frozen' '--script' '--link-mode' '--refresh'
                '--refresh-package' '-p' '--python' '--no-python-downloads' '--no-config'
            ],
        'tree' :
            [
                '--universal' '--format' '-d' '--depth' '--prune' '--package' '--no-dedupe'
                '--invert' '--outdated' '--show-sizes' '--no-dev' '--only-dev' '--group'
                '--no-group' '--no-default-groups' '--only-group' '--all-groups' '--locked'
                '--frozen' '--script' '--python-version' '--python-platform' '--no-build'
                '--no-build-package' '--no-binary' '--no-binary-package' '-C' '--config-setting'
                '--config-settings-package' '--no-build-isolation' '--no-build-isolation-package'
                '--link-mode' '-p' '--python' '--no-python-downloads' '--no-config'
            ],
        'format' :
            [
                '--check' '--diff' '--version' '--exclude-newer' '--no-project'
                '--no-python-downloads' '--no-config'
