# Whether an option of a subcommand consumes the next argument.
def __uvTakesValue (str str -- bool)
    opt! cmd!
    $"{@cmd} {@opt}" trim match
        '--version' 'add --editable' 'add --no-binary' 'audit --no-binary' 'build --no-binary'
        'check --no-binary' 'export --no-binary' 'init --package' 'init --script'
        'lock --no-binary' 'pip list --editable' 'pip list -e' 'pip show -f' 'python install -f'
        'python install -r' 'python upgrade -r' 'remove --no-binary' 'run --no-binary'
        'run --script' 'run -m' 'sync --no-binary' 'tool install --editable'
        'tool install --no-binary' 'tool install -e' 'tool run --no-binary'
        'tool upgrade --no-binary' 'tree --no-binary' 'venv -c' 'version --no-binary'
        'workspace metadata --no-binary' : false,
        _ : @opt match
            '--allow-insecure-host' '--annotation-style' '--author-from' '--bounds' '--branch'
            '--build-backend' '--build-constraints' '--bump' '--cache-dir' '--cert' '--check-url'
            '--color' '--config-file' '--config-setting' '--config-setting-package'
            '--config-settings-package' '--constraints' '--custom-compile-command'
            '--default-index' '--depth' '--description' '--directory' '--editable' '--env-file'
            '--exclude' '--exclude-newer' '--exclude-newer-package' '--excludes' '--extra'
            '--extra-index-url' '--find-links' '--fork-strategy' '--format' '--from' '--group'
            '--ignore' '--ignore-until-fixed' '--index' '--index-strategy' '--index-url'
            '--install-dir' '--keyring-provider' '--link-mode' '--marker' '--mirror' '--name'
            '--no-binary' '--no-binary-package' '--no-build-isolation-package' '--no-build-package'
            '--no-editable-package' '--no-emit-package' '--no-extra' '--no-group'
            '--no-install-package' '--no-sources-package' '--only-binary' '--only-group'
            '--optional' '--out-dir' '--output-file' '--output-format' '--overrides' '--package'
            '--password' '--path' '--prefix' '--prerelease' '--prerelease-package' '--project'
            '--prompt' '--prune' '--publish-url' '--pypy-mirror' '--python'
            '--python-downloads-json-url' '--python-platform' '--python-version'
            '--refresh-package' '--reinstall-package' '--requirements' '--resolution' '--rev'
            '--script' '--service-format' '--service-url' '--tag' '--target' '--token'
            '--torch-backend' '--trusted-publishing' '--ty-version' '--upgrade-group'
            '--upgrade-package' '--username' '--vcs' '--version' '--with' '--with-editable'
            '--with-executables-from' '--with-requirements' '-C' '-P' '-b' '-c' '-d' '-e' '-f' '-i'
            '-m' '-o' '-p' '-r' '-t' '-u' '-w' : true,
            _ : false,
        end,
    end
end

# The fixed values an option accepts, some of which differ between subcommands.
def __uvOptionChoices (str str -- [str])
    opt! cmd!
    $"{@cmd} {@opt}" trim match
        'version --output-format' 'sync --output-format' 'python list --output-format'
        'self version --output-format' 'tree --format' :
            ['text' 'json'],
        'audit --output-format' 'tool audit --output-format' : ['text' 'json' 'sarif'],
        'cache size --output-format' : ['auto' 'human' 'machine'],
        'export --format' : ['requirements.txt' 'pylock.toml' 'cyclonedx1.5'],
        'pip compile --format' : ['requirements.txt' 'pylock.toml'],
        'pip list --format' : ['columns' 'freeze' 'json'],
        _ : @opt match
            '--color' : ['auto' 'always' 'never'],
            '--keyring-provider' : ['disabled' 'subprocess'],
            '--python-platform' :
                [
                    'windows' 'linux' 'macos' 'x86_64-pc-windows-msvc' 'aarch64-pc-windows-msvc'
                    'i686-pc-windows-msvc' 'x86_64-unknown-linux-gnu' 'aarch64-apple-darwin'
                    'x86_64-apple-darwin' 'aarch64-unknown-linux-gnu' 'aarch64-unknown-linux-musl'
                    'x86_64-unknown-linux-musl' 'riscv64-unknown-linux' 'x86_64-manylinux2014'
                    'x86_64-manylinux_2_17' 'x86_64-manylinux_2_28' 'x86_64-manylinux_2_31'
                    'x86_64-manylinux_2_32' 'x86_64-manylinux_2_33' 'x86_64-manylinux_2_34'
                    'x86_64-manylinux_2_35' 'x86_64-manylinux_2_36' 'x86_64-manylinux_2_37'
                    'x86_64-manylinux_2_38' 'x86_64-manylinux_2_39' 'x86_64-manylinux_2_40'
                    'aarch64-manylinux2014' 'aarch64-manylinux_2_17' 'aarch64-manylinux_2_28'
                    'aarch64-manylinux_2_31' 'aarch64-manylinux_2_32' 'aarch64-manylinux_2_33'
                    'aarch64-manylinux_2_34' 'aarch64-manylinux_2_35' 'aarch64-manylinux_2_36'
                    'aarch64-manylinux_2_37' 'aarch64-manylinux_2_38' 'aarch64-manylinux_2_39'
                    'aarch64-manylinux_2_40' 'aarch64-linux-android' 'x86_64-linux-android'
                    'wasm32-pyodide2024' 'wasm32-pyodide2025' 'arm64-apple-ios'
                    'arm64-apple-ios-simulator' 'x86_64-apple-ios-simulator'
                ],
            '--index-strategy' : ['first-index' 'unsafe-first-match' 'unsafe-best-match'],
            '--resolution' : ['highest' 'lowest' 'lowest-direct'],
            '--prerelease' :
                ['disallow' 'allow' 'if-necessary' 'explicit' 'if-necessary-or-explicit'],
            '--fork-strategy' : ['fewest' 'requires-python'],
            '--link-mode' : ['clone' 'copy' 'hardlink' 'symlink'],
            '--vcs' : ['git' 'none'],
            '--build-backend' :
                ['uv' 'hatch' 'flit' 'pdm' 'poetry' 'setuptools' 'maturin' 'scikit'],
            '--author-from' : ['auto' 'git' 'none'],
            '--bounds' : ['lower' 'major' 'minor' 'exact'],
            '--bump' : ['major' 'minor' 'patch' 'stable' 'alpha' 'beta' 'rc' 'post' 'dev'],
            '--service-format' : ['osv'],
            '--torch-backend' :
                [
                    'auto' 'cpu' 'cu132' 'cu130' 'cu129' 'cu128' 'cu126' 'cu125' 'cu124' 'cu123'
                    'cu122' 'cu121' 'cu120' 'cu118' 'cu117' 'cu116' 'cu115' 'cu114' 'cu113' 'cu112'
                    'cu111' 'cu110' 'cu102' 'cu101' 'cu100' 'cu92' 'cu91' 'cu90' 'cu80' 'rocm7.2'
                    'rocm7.1' 'rocm7.0' 'rocm6.4' 'rocm6.3' 'rocm6.2.4' 'rocm6.2' 'rocm6.1'
                    'rocm6.0' 'rocm5.7' 'rocm5.6' 'rocm5.5' 'rocm5.4.2' 'rocm5.4' 'rocm5.3'
                    'rocm5.2' 'rocm5.1.1' 'rocm4.2' 'rocm4.1' 'rocm4.0.1' 'xpu'
                ],
            '--annotation-style' : ['line' 'split'],
            '--trusted-publishing' : ['automatic' 'always' 'never'],
            _ : [] as [str],
        end,
    end
end


# Python versions from the listing of `uv python list`, both as 3.12 and as 3.12.4.
def __uvPythonVersions ([str] -- [str])
    args!
    ['uv' 'python' 'list' @args] * ; out!
    @out '(?m)^[a-z]+-(([0-9]+\.[0-9]+)\.[0-9]+[a-z0-9]*)-' reFindAll
    (row! [@row :2: @row :1:]) map concat uniq
end

# Tools installed with `uv tool install`; their executables are the indented lines.
def __uvTools ( -- [str])
    ['uv' 'tool' 'list'] * ; '(?m)^([A-Za-z0-9._-]+) v' reFindAll (:1:) map
end

# Packages installed in the current environment.
def __uvPipPackages ( -- [str])
    ['uv' 'pip' 'list' '--format' 'freeze'] * ; '(?m)^([A-Za-z0-9._-]+)' reFindAll (:1:) map
end

# Direct dependencies of the current project, read from its lockfile.
def __uvProjectDependencies ( -- [str])
    ['uv' 'tree' '--depth' '1' '--frozen'] * ; '── ([A-Za-z0-9._-]+)' reFindAll (:1:) map uniq
end

# Commands installed in the project's virtual environment, for `uv run`.
def __uvVenvCommands ( -- [str])
    runtime 'windows' = if
        '.venv\Scripts\*.exe' glob (basename stem str) map
    else
        '.venv/bin/*' glob (basename str) map (dup 'activate' startsWith swap 'deactivate' startsWith or not) filter
    end
end

# Completions for the value of an option.
def __uvOptionValues (str str str -- [str])
    prefix! opt! cmd!
    @opt match
        '-p' '--python' : @cmd 'publish' = ([] as [str]) (['--only-installed'] __uvPythonVersions) iff,
        '--from' : __uvTools,
        # Options that take a file or directory
        '--directory' '--project' '--cache-dir' '--config-file' '--install-dir' '--out-dir'
        '-o' '--output-file' '-t' '--target' '--prefix' '-r' '--requirements' '-c' '--constraints'
        '--overrides' '--excludes' '-b' '--build-constraints' '--with-requirements' '--env-file'
        '-e' '--editable' '--with-editable' '-f' '--find-links' '--cert' '--script'
        '--python-downloads-json-url' '--path' : @prefix completeFiles,
        _ : @cmd @opt __uvOptionChoices,
    end
end

# Completions for the arguments of a subcommand that are not options.
def __uvArguments (str str -- [str])
    prefix! cmd!
    @cmd match
        'run' : __uvVenvCommands @prefix completeFiles extend,
        'remove' : __uvProjectDependencies,
        'tool run' 'tool upgrade' 'tool uninstall' : __uvTools,
        'python uninstall' 'python pin' 'python find' 'python upgrade' : ['--only-installed'] __uvPythonVersions,
        'python install' : [] as [str] __uvPythonVersions,
        'pip uninstall' 'pip show' : __uvPipPackages,
        # Packages given by path, requirements files, and scripts
        'add' 'pip install' 'pip compile' 'pip sync' 'publish' 'format' : @prefix completeFiles,
        'init' 'venv' 'build' : @prefix completeDirs,
        _ : [] as [str],
    end
end

def __uvCompletion { 'complete': ['uv'] } ([str] str -- [str])
    prefix! input!
    @input (__uvSubcommands) (drop '') (__uvTakesValue) __subcommandPath rest! path!
    @path ' ' join cmd!
    @input len 0 > if @input :-1: else '' end last!

    @cmd 'help' = if
        # `uv help pip install`: the words after help name a subcommand.
        @rest ' ' join __uvSubcommands
    else* @rest len 0 > @cmd 'run' = @cmd 'tool run' = or and *if
        # Everything after the command to run belongs to that command.
        @rest @prefix completeCommand
    else* @cmd @last __uvTakesValue *if
        @cmd @last @prefix __uvOptionValues
    else* @prefix '-' startsWith *if
        __uvGlobalOptions
        @cmd __uvOwnOptions extend
        @cmd __uvOptionGroups (__uvGroupOptions) map concat extend
    else
        @cmd __uvSubcommands @cmd @prefix __uvArguments extend
    end
end

# `uvx` is `uv tool run`.
def __uvxCompletion { 'complete': ['uvx'] } ([str] str -- [str])
    prefix! input!
    ['tool' 'run'] @input + @prefix __uvCompletion
end
# }}}
# typst {{{
def __typstSubcommands (str -- [str])
    match
        '' : ['compile' 'watch' 'init' 'eval' 'fonts' 'update' 'completions' 'info' 'help'],
        _ : [] as [str],
    end
end

def __typstAlias (str -- str)
    match
        'c' : 'compile',
        'w' : 'watch',
        _ : '',
    end
end

# typst options that consume the next argument.
# `--open` takes an optional viewer only when written as `--open=viewer`, so it is a flag here.
def __typstTakesValue (str str -- bool)
    opt! cmd!
    @opt match
        '--color' '--cert' '-f' '--format' '--root' '--input' '--font-path' '--package-path'
        '--package-cache-path' '--creation-timestamp' '--pages' '--pdf-standard' '--ppi' '--deps'
        '--deps-format' '-j' '--jobs' '--features' '--diagnostic-format' '--timings' '--port'
        '--in' '--target' '--backup-path' : true,
        _ : false,
    end
end

def __typstOptions (str -- [str])
    match
        '' : ['--color' '--cert' '-h' '--help' '-V' '--version'],
        'compile' 'watch' :
            [
                '-f' '--format' '--root' '--input' '--font-path' '--ignore-system-fonts'
                '--ignore-embedded-fonts' '--package-path' '--package-cache-path'
                '--creation-timestamp' '--pretty' '--pages' '--pdf-standard' '--no-pdf-tags' '--ppi'
                '--deps' '--deps-format' '-j' '--jobs' '--features' '--diagnostic-format' '--open'
                '--timings' '-h' '--help'
            ],
        'init' : ['--package-path' '--package-cache-path' '-h' '--help'],
        'eval' :
            [
                '--in' '--target' '--format' '--pretty' '--root' '--input' '--font-path'
                '--ignore-system-fonts' '--ignore-embedded-fonts' '--package-path'
                '--package-cache-path' '--creation-timestamp' '-j' '--jobs' '--features'
                '--diagnostic-format' '-h' '--help'
            ],
        'fonts' : ['--font-path' '--ignore-system-fonts' '--ignore-embedded-fonts' '--variants' '-h' '--help'],
        'update' : ['--force' '--revert' '--backup-path' '-h' '--help'],
        'info' : ['-f' '--format' '--pretty' '-h' '--help'],
        _ : ['-h' '--help'],
    end
end

def __typstOptionValues (str str str -- [str])
    prefix! opt! cmd!
    @opt match
        '--color' : ['auto' 'always' 'never'],
        '-f' '--format' : @cmd match
            'compile' 'watch' : ['pdf' 'png' 'svg' 'html' 'bundle'],
            _ : ['json' 'yaml'],
        end,
        '--pdf-standard' :
            [
                '1.4' '1.5' '1.6' '1.7' '2.0' 'a-1b' 'a-1a' 'a-2b' 'a-2u' 'a-2a' 'a-3b' 'a-3u' 'a-3a'
                'a-4' 'a-4f' 'a-4e' 'ua-1'
            ],
        '--deps-format' : ['json' 'zero' 'make'],
        '--features' : ['html' 'bundle' 'a11y-extras'],
        '--diagnostic-format' : ['human' 'short'],
        '--target' : ['paged' 'html' 'bundle'],
        '--root' '--font-path' '--package-path' '--package-cache-path' : @prefix completeDirs,
        '--cert' '--deps' '--timings' '--backup-path' : @prefix completeFiles,
        _ : [] as [str],
    end
end

def __typstCompletion { 'complete': ['typst'] } ([str] str -- [str])
    prefix! input!
    @input (__typstSubcommands) (__typstAlias) (__typstTakesValue) __subcommandPath rest! path!
    @path ' ' join cmd!
    @input len 0 > if @input :-1: else '' end last!

    @cmd @last __typstTakesValue if
        @cmd @last @prefix __typstOptionValues
    else* @prefix '-' startsWith *if
        @cmd __typstOptions
    else
        @cmd match
            '' 'help' : '' __typstSubcommands,
            'compile' 'watch' :
                @prefix completeFiles files!
                # The input file comes first, so list .typ files before the rest.
                @rest len 0 = if
                    @files ('.typ' endsWith) filter @files ('.typ' endsWith not) filter extend
                else
                    @files
                end,
            'init' : @rest len 0 > (@prefix completeDirs) ([] as [str]) iff,
            'completions' : ['bash' 'elvish' 'fish' 'powershell' 'zsh'],
            _ : [] as [str],
        end
    end
end
# }}}
# winget {{{
# Options accepted by every winget command.
def __wingetGlobalOptions ( -- [str])
    [
        '-?' '--help' '--wait' '--logs' '--open-logs' '--verbose' '--verbose-logs' '--nowarn'
        '--ignore-warnings' '--disable-interactivity' '--proxy' '--no-proxy'
    ]
end

# Subcommands under a space-joined winget subcommand path; the top level is the empty string.
def __wingetSubcommands (str -- [str])
    match
        '' :
            [
                'install' 'show' 'source' 'search' 'list' 'upgrade' 'uninstall' 'hash' 'validate'
                'settings' 'features' 'export' 'import' 'pin' 'configure' 'download' 'repair'
                'dscv3' 'mcp'
            ],
        'source' : ['add' 'list' 'update' 'remove' 'edit' 'reset' 'export'],
        'settings' : ['export' 'set' 'reset'],
        'pin' : ['add' 'remove' 'list' 'reset'],
        'configure' : ['show' 'list' 'test' 'validate' 'export'],
        'dscv3' : ['package' 'source' 'user-settings-file' 'admin-settings'],
        _ : [] as [str],
    end
end

# The subcommand an alias stands for, keyed by the space-joined alias path, or the empty string.
def __wingetAlias (str -- str)
    match
        'add' : 'install',
        'view' : 'show',
        'source ls' : 'list',
        'source refresh' : 'update',
        'source rm' : 'remove',
        'source config' : 'edit',
        'source set' : 'edit',
        'find' : 'search',
        'ls' : 'list',
        'update' : 'upgrade',
        'remove' : 'uninstall',
        'rm' : 'uninstall',
        'config' : 'settings',
        'configuration' : 'configure',
        'dsc' : 'configure',
        'configure view' : 'show',
        'configure ls' : 'list',
        'fix' : 'repair',
        _ : '',
    end
end

# Options of each subcommand beyond the global options.
def __wingetOptions (str -- [str])
    match
        '' : ['-v' '--version' '--info'],
        'install' :
            [
                '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '-v' '--version' '-s'
                '--source' '--scope' '-a' '--architecture' '--installer-type' '-e' '--exact' '-i'
                '--interactive' '-h' '--silent' '--locale' '-o' '--log' '--custom' '--override'
                '-l' '--location' '--ignore-security-hash' '--allow-reboot' '--skip-dependencies'
                '--dependencies-only' '--ignore-local-archive-malware-scan' '--dependency-source'
                '--accept-package-agreements' '--no-upgrade' '--header' '--authentication-mode'
                '--authentication-account' '--accept-source-agreements' '-r' '--rename'
                '--uninstall-previous' '--force'
            ],
        'show' :
            [
                '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '-v' '--version' '-s'
                '--source' '-e' '--exact' '--scope' '-a' '--architecture' '--installer-type'
                '--locale' '--versions' '--header' '--authentication-mode'
                '--authentication-account' '--accept-source-agreements'
            ],
        'source add' :
            [
                '-n' '--name' '-a' '--arg' '-t' '--type' '--trust-level' '--header'
                '--accept-source-agreements' '--explicit'
            ],
        'source list' 'source update' 'source remove' 'source export' : ['-n' '--name'],
        'source edit' : ['-n' '--name' '-e' '--explicit'],
        'source reset' : ['-n' '--name' '--force'],
        'search' :
            [
                '-q' '--query' '--id' '--name' '--moniker' '--tag' '--cmd' '--command' '-s'
                '--source' '-n' '--count' '-e' '--exact' '--header' '--authentication-mode'
                '--authentication-account' '--accept-source-agreements' '--versions'
            ],
        'list' :
            [
                '-q' '--query' '--id' '--name' '--moniker' '-s' '--source' '--tag' '--cmd'
                '--command' '-n' '--count' '-e' '--exact' '--scope' '--header'
                '--authentication-mode' '--authentication-account' '--accept-source-agreements'
                '--upgrade-available' '-u' '--unknown' '--include-unknown' '--pinned'
                '--include-pinned' '--details' '--sort' '--asc' '--ascending' '--desc'
                '--descending'
            ],
        'upgrade' :
            [
                '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '-v' '--version' '-s'
                '--source' '-e' '--exact' '-i' '--interactive' '-h' '--silent' '--purge' '-o'
                '--log' '--custom' '--override' '-l' '--location' '--scope' '-a' '--architecture'
                '--installer-type' '--locale' '--ignore-security-hash' '--allow-reboot'
                '--skip-dependencies' '--ignore-local-archive-malware-scan'
                '--accept-package-agreements' '--accept-source-agreements' '--header'
                '--authentication-mode' '--authentication-account' '-r' '--recurse' '--all' '-u'
                '--unknown' '--include-unknown' '--pinned' '--include-pinned'
                '--uninstall-previous' '--force'
            ],
        'uninstall' :
            [
                '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '--product-code' '-v'
                '--version' '--all' '--all-versions' '-s' '--source' '-e' '--exact' '--scope' '-i'
                '--interactive' '-h' '--silent' '--force' '--purge' '--preserve' '-o' '--log'
                '--header' '--authentication-mode' '--authentication-account'
                '--accept-source-agreements'
            ],
        'hash' : ['-f' '--file' '-m' '--msix'],
        'validate' : ['--manifest'],
        'settings' 'mcp' : ['--enable' '--disable'],
        'settings set' : ['--setting' '--value'],
        'settings reset' : ['--setting' '-r' '--recurse' '--all'],
        'export' :
            ['-o' '--output' '-s' '--source' '--include-versions' '--accept-source-agreements'],
        'import' :
            [
                '-i' '--import-file' '--ignore-unavailable' '--ignore-versions' '--no-upgrade'
                '--accept-package-agreements' '--accept-source-agreements'
            ],
        'pin add' :
            [
                '-q' '--query' '--id' '--name' '--moniker' '--tag' '--cmd' '--command' '-e'
                '--exact' '-v' '--version' '-s' '--source' '--header' '--authentication-mode'
                '--authentication-account' '--accept-source-agreements' '--force' '--blocking'
                '--installed'
            ],
        'pin remove' :
            [
                '-q' '--query' '--id' '--name' '--moniker' '-s' '--source' '--tag' '--cmd'
                '--command' '-e' '--exact' '--header' '--authentication-mode'
                '--authentication-account' '--accept-source-agreements' '--installed'
            ],
        'pin list' :
            [
                '-q' '--query' '--id' '--name' '--moniker' '-s' '--source' '--tag' '--cmd'
                '--command' '-e' '--exact' '--header' '--authentication-mode'
                '--authentication-account' '--accept-source-agreements'
            ],
        'pin reset' : ['--force' '-s' '--source'],
        'configure' :
            [
                '-f' '--file' '--module-path' '--processor-path' '-h' '--history'
                '--accept-configuration-agreements' '--suppress-initial-details' '--enable'
                '--disable'
            ],
        'configure show' : ['-f' '--file' '--module-path' '--processor-path' '-h' '--history'],
        'configure list' : ['-h' '--history' '-o' '--output' '--remove'],
        'configure test' :
            [
                '-f' '--file' '--module-path' '--processor-path' '-h' '--history'
                '--suppress-initial-details' '--accept-configuration-agreements'
            ],
        'configure validate' : ['-f' '--file' '--module-path' '--processor-path'],
        'configure export' :
            [
                '-o' '--output' '--package-id' '--module' '--resource' '--module-path'
                '--processor-path' '-s' '--source' '--include-versions' '-r' '--recurse' '--all'
                '--accept-source-agreements'
            ],
        'download' :
            [
                '-q' '--query' '-d' '--download-directory' '-m' '--manifest' '--id' '--name'
                '--moniker' '-v' '--version' '-s' '--source' '--scope' '-a' '--architecture'
                '--installer-type' '-e' '--exact' '--locale' '--ignore-security-hash'
                '--skip-dependencies' '--header' '--authentication-mode' '--authentication-account'
                '--accept-package-agreements' '--accept-source-agreements' '--skip-license'
                '--skip-microsoft-store-package-license' '--platform' '--os-version'
            ],
        'repair' :
            [
                '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '-v' '--version'
                '--product-code' '-a' '--architecture' '--scope' '-s' '--source' '-i'
                '--interactive' '-h' '--silent' '-o' '--log' '--ignore-local-archive-malware-scan'
                '--accept-source-agreements' '--accept-package-agreements' '--locale' '--header'
                '--authentication-mode' '--authentication-account' '--force'
                '--ignore-security-hash' '-e' '--exact'
            ],
        'dscv3' : ['--manifest' '-o' '--output'],
        'dscv3 package' 'dscv3 source' 'dscv3 user-settings-file' 'dscv3 admin-settings' :
            ['--get' '--set' '--test' '--export' '--schema' '--manifest' '-o' '--output'],
        _ : [] as [str],
    end
end

# Whether an option of a subcommand consumes the next argument.
# The same short option can be a flag in one subcommand and take a value in another,
# like -i for --interactive in install and --import-file in import.
def __wingetTakesValue (str str -- bool)
    opt! cmd!
    @opt match
        '--proxy' : true,
        _ : @cmd match
            'install' :
                @opt match
                    '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '-v' '--version'
                    '-s' '--source' '--scope' '-a' '--architecture' '--installer-type' '--locale'
                    '-o' '--log' '--custom' '--override' '-l' '--location' '--dependency-source'
                    '--header' '--authentication-mode' '--authentication-account' '-r' '--rename' : true,
                    _ : false,
                end,
            'show' :
                @opt match
                    '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '-v' '--version'
                    '-s' '--source' '--scope' '-a' '--architecture' '--installer-type' '--locale'
                    '--header' '--authentication-mode' '--authentication-account' : true,
                    _ : false,
                end,
            'source add' :
                @opt match
                    '-n' '--name' '-a' '--arg' '-t' '--type' '--trust-level' '--header' : true,
                    _ : false,
                end,
            'source list' 'source update' 'source remove' 'source reset' 'source export' :
                @opt match
                    '-n' '--name' : true,
                    _ : false,
                end,
            'source edit' :
                @opt match
                    '-n' '--name' '-e' '--explicit' : true,
                    _ : false,
                end,
            'search' :
                @opt match
                    '-q' '--query' '--id' '--name' '--moniker' '--tag' '--cmd' '--command' '-s'
                    '--source' '-n' '--count' '--header' '--authentication-mode'
                    '--authentication-account' : true,
                    _ : false,
                end,
            'list' :
                @opt match
                    '-q' '--query' '--id' '--name' '--moniker' '-s' '--source' '--tag' '--cmd'
                    '--command' '-n' '--count' '--scope' '--header' '--authentication-mode'
                    '--authentication-account' '--sort' : true,
                    _ : false,
                end,
            'upgrade' :
                @opt match
                    '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '-v' '--version'
                    '-s' '--source' '-o' '--log' '--custom' '--override' '-l' '--location'
                    '--scope' '-a' '--architecture' '--installer-type' '--locale' '--header'
                    '--authentication-mode' '--authentication-account' : true,
                    _ : false,
                end,
            'uninstall' :
                @opt match
                    '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '--product-code'
                    '-v' '--version' '-s' '--source' '--scope' '-o' '--log' '--header'
                    '--authentication-mode' '--authentication-account' : true,
                    _ : false,
                end,
            'hash' :
                @opt match
                    '-f' '--file' : true,
                    _ : false,
                end,
            'validate' :
                @opt match
                    '--manifest' : true,
                    _ : false,
                end,
            'settings' :
                @opt match
                    '--enable' '--disable' : true,
                    _ : false,
                end,
            'settings set' :
                @opt match
                    '--setting' '--value' : true,
                    _ : false,
                end,
            'settings reset' :
                @opt match
                    '--setting' : true,
                    _ : false,
                end,
            'export' :
                @opt match
                    '-o' '--output' '-s' '--source' : true,
                    _ : false,
                end,
            'import' :
                @opt match
                    '-i' '--import-file' : true,
                    _ : false,
                end,
            'pin add' :
                @opt match
                    '-q' '--query' '--id' '--name' '--moniker' '--tag' '--cmd' '--command' '-v'
                    '--version' '-s' '--source' '--header' '--authentication-mode'
                    '--authentication-account' : true,
                    _ : false,
                end,
            'pin remove' 'pin list' :
                @opt match
                    '-q' '--query' '--id' '--name' '--moniker' '-s' '--source' '--tag' '--cmd'
                    '--command' '--header' '--authentication-mode' '--authentication-account' : true,
                    _ : false,
                end,
            'pin reset' :
                @opt match
                    '-s' '--source' : true,
                    _ : false,
                end,
            'configure' 'configure show' 'configure test' :
                @opt match
                    '-f' '--file' '--module-path' '--processor-path' '-h' '--history' : true,
                    _ : false,
                end,
            'configure list' :
                @opt match
                    '-h' '--history' '-o' '--output' : true,
                    _ : false,
                end,
            'configure validate' :
                @opt match
                    '-f' '--file' '--module-path' '--processor-path' : true,
                    _ : false,
                end,
            'configure export' :
                @opt match
                    '-o' '--output' '--package-id' '--module' '--resource' '--module-path'
                    '--processor-path' '-s' '--source' : true,
                    _ : false,
                end,
            'download' :
                @opt match
                    '-q' '--query' '-d' '--download-directory' '-m' '--manifest' '--id' '--name'
                    '--moniker' '-v' '--version' '-s' '--source' '--scope' '-a' '--architecture'
                    '--installer-type' '--locale' '--header' '--authentication-mode'
                    '--authentication-account' '--platform' '--os-version' : true,
                    _ : false,
                end,
            'repair' :
                @opt match
                    '-q' '--query' '-m' '--manifest' '--id' '--name' '--moniker' '-v' '--version'
                    '--product-code' '-a' '--architecture' '--scope' '-s' '--source' '-o' '--log'
                    '--locale' '--header' '--authentication-mode' '--authentication-account' : true,
                    _ : false,
                end,
            'dscv3' 'dscv3 package' 'dscv3 source' 'dscv3 user-settings-file'
            'dscv3 admin-settings' :
                @opt match
                    '--manifest' '-o' '--output' : true,
                    _ : false,
                end,
            _ : false,
        end,
    end
end


# Names of the configured package sources: the first column of `winget source list`,
# on the lines after the dashed line under its header.
def __wingetSources ( -- [str])
    ['winget' 'source' 'list'] * ; '(?s)-{5,}\r?\n(.*)' reFindAll rows!
    @rows len 0 > if
        @rows :0: :1: lines (trim) map (len 0 >) filter (wsplit :0:) map
    else
        [] as [str]
    end
end

# Administrator settings for `winget settings --enable` and `--disable`.
def __wingetAdminSettings ( -- [str])
    [
        'LocalManifestFiles' 'BypassCertificatePinningForMicrosoftStore' 'InstallerHashOverride'
        'LocalArchiveMalwareScanOverride' 'ProxyCommandLineOptions' 'ConfigurationProcessorPath'
    ]
end

# Completions for the value of an option.
def __wingetOptionValues (str str str -- [str])
    prefix! opt! cmd!
    @opt match
        '-s' '--source' '--dependency-source' : __wingetSources,
        '-n' '--name' : @cmd 'source' startsWith @cmd 'source add' = not and (__wingetSources) ([] as [str]) iff,
        '--scope' : ['user' 'machine'],
        '-a' '--architecture' : @cmd 'source add' = ([] as [str]) (['x86' 'x64' 'arm' 'arm64' 'neutral']) iff,
        '--installer-type' :
            ['msix' 'msi' 'appx' 'exe' 'zip' 'inno' 'nullsoft' 'wix' 'burn' 'pwa' 'portable'],
        '--authentication-mode' : ['silent' 'silentPreferred' 'interactive'],
        '--sort' : ['name' 'id' 'version' 'source' 'available' 'relevance'],
        '--platform' :
            ['Windows.Universal' 'Windows.Desktop' 'Windows.IoT' 'Windows.Team' 'Windows.Holographic'],
        '--trust-level' : ['none' 'trusted'],
        '-t' '--type' : ['Microsoft.PreIndexed.Package' 'Microsoft.Rest'],
        '-e' '--explicit' : ['true' 'false'],
        '--enable' '--disable' : __wingetAdminSettings,
        '--setting' : @cmd 'settings set' = (['DefaultProxy']) (__wingetAdminSettings ['DefaultProxy'] extend) iff,
        # Options that take a file or directory
        '-m' '--manifest' '-o' '--log' '--output' '-f' '--file' '-i' '--import-file' '-l' '--location'
        '-d' '--download-directory' '--module-path' '--processor-path' : @prefix completeFiles,
        _ : [] as [str],
    end
end

# Completions for the arguments of a subcommand that are not options.
def __wingetArguments (str [str] str -- [str])
    prefix! rest! cmd!
    @cmd match
        'source list' 'source update' 'source remove' 'source edit' 'source reset' 'source export' :
            __wingetSources,
        'settings set' : @rest len 0 = (['DefaultProxy']) ([] as [str]) iff,
        'settings reset' : __wingetAdminSettings ['DefaultProxy'] extend,
        'hash' 'validate' 'import' 'configure' 'configure show' 'configure test' 'configure validate' :
            @prefix completeFiles,
        _ : [] as [str],
    end
end

def __wingetCompletion { 'complete': ['winget' 'winget.exe'] } ([str] str -- [str])
    prefix! input!
    @input (__wingetSubcommands) (__wingetAlias) (__wingetTakesValue) __subcommandPath rest! path!
    @path ' ' join cmd!
    @input len 0 > if @input :-1: else '' end last!

    @cmd @last __wingetTakesValue if
        @cmd @last @prefix __wingetOptionValues
    else* @prefix '-' startsWith *if
        __wingetGlobalOptions @cmd __wingetOptions extend
    else
        @cmd __wingetSubcommands @cmd @rest @prefix __wingetArguments extend
    end
end
# }}}
# }}}
